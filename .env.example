# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Ключ https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Модели (укажите актуальные из вашего аккаунта)
OPENAI_MODEL_VALIDATE=gpt-4o-mini
OPENAI_MODEL_READING=gpt-4o
OPENAI_MODEL_TEASER=gpt-4o-mini

# Бесплатный лимит: total — на всё время, daily — в сутки (UTC)
FREE_MODE=total
FREE_READINGS=2

# Контакт для /paysupport (обязателен для платежей в Stars)
SUPPORT_CONTACT=@your_support

DB_PATH=tarot.db
